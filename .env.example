# Banco Turso (obrigatório na Vercel; opcional localmente)
TURSO_DATABASE_URL=libsql://seu-banco-sua-org.turso.io
TURSO_AUTH_TOKEN=seu-token-do-turso

# Token compartilhado entre a API na Vercel e os workers locais/VPS
JUDGE_TOKEN=troque-por-um-segredo-forte

# Tempo de reserva da tarefa em milissegundos (opcional, padrão 10000)
LEASE_MS=10000
